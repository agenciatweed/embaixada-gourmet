---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { moments } from '../data/content';
import abrir from '../../assets/plates/abrir.png';
import ajustar from '../../assets/plates/ajustar.png';
import crescer from '../../assets/plates/crescer.png';

const photos = {
  abrir: { src: abrir, alt: 'Salão de um restaurante novo na semana da inauguração, com cadeiras ainda empilhadas (imagem ilustrativa)' },
  ajustar: { src: ajustar, alt: 'Mãos de um chef anotando fichas técnicas ao lado de uma balança na bancada da cozinha (imagem ilustrativa)' },
  crescer: { src: crescer, alt: 'Salão de restaurante lotado à noite (imagem ilustrativa)' },
} as const;
---
<section class="section moments" id="momentos" aria-labelledby="momentos-title">
  <div class="container">
    <header class="moments-head">
      <h2 class="h2" id="momentos-title">Em que momento está a sua casa?</h2>
      <p class="lead">
        A Embaixada não vende uma lista de serviços. Ela começa pelo momento do restaurante e monta a resposta a
        partir dele.
      </p>
    </header>

    <ul class="moments-grid">
      {moments.map((m) => (
        <li class:list={['moment', `moment-${m.id}`]}>
          <Image
            src={photos[m.id as keyof typeof photos].src}
            alt={photos[m.id as keyof typeof photos].alt}
            widths={[480, 800, 1200, 1800]}
            sizes="(max-width: 900px) 100vw, 58vw"
            format="webp"
            quality={72}
            class="moment-photo"
          />
          <div class="moment-body">
            <h3 class="moment-title">{m.title}</h3>
            <p class="moment-situation">{m.situation}</p>
            <p class="moment-text">{m.body}</p>
            <a class="moment-link" href="#produtos">
              {m.product} <Icon name="arrow-right" class="moment-arrow" />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (fine.matches && !calm.matches) {
    document.querySelectorAll<HTMLElement>('.moment').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.setProperty('--rx', `${(-y * 5).toFixed(2)}deg`);
        card.style.setProperty('--ry', `${(x * 5).toFixed(2)}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>

<style>
  .moments {
    padding-top: clamp(140px, 13vw, 240px);
  }

  .moments-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 96px);
    align-items: end;
    margin-bottom: clamp(40px, 4vw, 72px);
  }

  .moments-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(320px, 27vw));
    gap: clamp(16px, 1.4vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moment {
    position: relative;
    overflow: hidden;
    transform: perspective(1200px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 500ms var(--ease-out);
    will-change: transform;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--graphite);
    isolation: isolate;
  }

  .moment-abrir {
    grid-column: 1 / span 7;
    grid-row: 1 / span 2;
  }

  .moment-ajustar {
    grid-column: 8 / span 5;
    grid-row: 1;
  }

  .moment-crescer {
    grid-column: 8 / span 5;
    grid-row: 2;
  }

  .moment :global(.moment-photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
    transform: scale(1.001);
    transition:
      opacity 600ms var(--ease-out),
      transform 900ms var(--ease-out);
  }

  .moment::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(9, 9, 11, 0.94) 0%, rgba(9, 9, 11, 0.55) 45%, rgba(9, 9, 11, 0) 75%);
  }

  .moment:hover :global(.moment-photo) {
    opacity: 0.8;
    transform: scale(1.04);
  }

  .moment-body {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(24px, 2.2vw, 40px);
  }

  .moment-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62%;
    font-variation-settings: 'wdth' 62;
    font-size: clamp(3rem, 5vw, 5.5rem);
    line-height: 1;
    text-transform: uppercase;
    transition: transform 500ms var(--ease-out);
  }

  .moment-ajustar .moment-title,
  .moment-crescer .moment-title {
    font-size: clamp(2.5rem, 3.6vw, 4rem);
  }

  .moment:hover .moment-title {
    transform: translateX(16px);
  }

  .moment-situation {
    max-width: 34ch;
    margin-top: 14px;
    font-size: clamp(1.125rem, 1.35vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--paper);
  }

  .moment-text {
    max-width: 52ch;
    margin-top: 10px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #c4c4c9;
  }

  .moment-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--green);
  }

  .moment-link :global(.moment-arrow) {
    width: 16px;
    transition: transform 300ms var(--ease-out);
  }

  .moment-link:hover :global(.moment-arrow) {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .moments-head {
      grid-template-columns: 1fr;
    }

    .moments-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .moment-abrir,
    .moment-ajustar,
    .moment-crescer {
      grid-column: 1;
      grid-row: auto;
      min-height: 440px;
    }
  }
</style>
