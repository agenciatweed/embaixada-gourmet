---
import { steps } from '../data/content';
---
<section class="section steps" aria-labelledby="como-title">
  <div class="container">
    <h2 class="h2" id="como-title">Como começa</h2>
    <ol class="steps-list">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="step-name">{s.name}</h3>
          <p class="step-detail">{s.detail}</p>
          <p class="step-body">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    padding-top: 0;
  }

  .steps-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 1.4vw, 24px);
    margin: clamp(40px, 4vw, 72px) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    position: relative;
    padding-top: clamp(20px, 2vw, 32px);
    border-top: 2px solid var(--rule-strong);
  }

  .step:first-child {
    border-top-color: var(--green);
  }

  .step-index {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    color: var(--green);
  }

  .step-name {
    margin-top: 18px;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62%;
    font-variation-settings: 'wdth' 62;
    font-size: clamp(1.75rem, 2.4vw, 2.625rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .step-detail {
    margin-top: 12px;
    font-weight: 600;
    color: var(--paper);
  }

  .step-body {
    max-width: 32ch;
    margin-top: 8px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--smoke);
  }

  @media (max-width: 1000px) {
    .steps-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }
  }

  @media (max-width: 560px) {
    .steps-list {
      grid-template-columns: 1fr;
    }
  }
</style>
