---
import Icon from './Icon.astro';
import { NAV, whatsappHref } from '../data/site';
---
<header class="site-header">
  <a class="brand" href="#topo" aria-label="Embaixada Gourmet, início">
    <img src="/brand/logo-tipografia-claro.svg" alt="Embaixada Gourmet" width="541" height="212" />
  </a>
  <nav class="nav" aria-label="Seções">
    <ul>
      {NAV.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
  <a class="pill" href={whatsappHref} target="_blank" rel="noopener">
    <span class="pill-fill" aria-hidden="true"></span>
    <Icon name="whatsapp" class="pill-icon" />
    <span class="pill-label">WhatsApp</span>
  </a>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 6.14vw;
    min-height: 64px;
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--rule);
  }

  .brand img {
    height: 3.4vw;
    min-height: 34px;
    width: auto;
  }

  .nav ul {
    position: relative;
    top: 0.22vw;
    display: flex;
    gap: 3.6vw;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    font-family: var(--font-display);
    font-stretch: 75%;
    font-variation-settings: 'wdth' 75;
    font-size: 1.32vw;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    transition: color 200ms var(--ease-out);
  }

  .nav a:hover {
    color: var(--green);
  }

  .pill {
    position: relative;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 1.1vw;
    height: 3.22vw;
    min-height: 44px;
    padding: 0 1.05vw 0 1.75vw;
    margin-right: -0.3vw;
    overflow: hidden;
    border: max(2px, 0.14vw) solid var(--green);
    border-radius: 999px;
    color: var(--paper);
    text-decoration: none;
    isolation: isolate;
  }

  .pill-fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--green);
    transform: translateY(101%);
    transition: transform 300ms var(--ease-out);
  }

  .pill:hover .pill-fill,
  .pill:focus-visible .pill-fill {
    transform: translateY(0);
  }

  .pill:hover,
  .pill:focus-visible {
    color: var(--void);
  }

  .pill :global(.pill-icon) {
    width: 1.62vw;
    min-width: 18px;
    height: auto;
  }

  .pill-label {
    font-family: var(--font-body);
    font-size: 1.22vw;
    font-weight: 400;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .site-header {
      grid-template-columns: 1fr auto;
      height: 72px;
    }

    .nav {
      display: none;
    }

    .pill-label {
      font-size: 13px;
    }

    .pill {
      gap: 8px;
      padding: 0 16px;
    }
  }
</style>
