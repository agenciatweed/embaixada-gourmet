---
import Icon from './Icon.astro';
import { rules, faq } from '../data/content';
---
<section class="section faq" id="perguntas" aria-labelledby="perguntas-title">
  <div class="container faq-grid">
    <div class="rules">
      <h2 class="h2" id="perguntas-title">Regras da casa</h2>
      <ul class="rules-list">
        {rules.map((r) => (
          <li>
            <h3 class="rule-title">{r.title}</h3>
            <p>{r.body}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="questions">
      <h2 class="questions-title">Perguntas frequentes</h2>
      {faq.map((item) => (
        <details class="question">
          <summary>
            <span>{item.q}</span>
            <span class="question-toggle" aria-hidden="true"><Icon name="plus" /></span>
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(48px, 6vw, 128px);
  }

  .rules-list {
    margin: clamp(32px, 3vw, 56px) 0 0;
    padding: 0;
    list-style: none;
  }

  .rules-list li {
    padding-block: clamp(18px, 1.6vw, 28px);
    border-top: 1px solid var(--rule);
  }

  .rule-title {
    font-size: clamp(1.25rem, 1.6vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--green);
  }

  .rules-list p {
    max-width: 48ch;
    margin-top: 8px;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--smoke);
  }

  .questions-title {
    margin-bottom: clamp(20px, 2vw, 32px);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--smoke);
  }

  .question {
    border-top: 1px solid var(--rule-strong);
  }

  .question:last-child {
    border-bottom: 1px solid var(--rule-strong);
  }

  .question summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: clamp(20px, 1.8vw, 28px);
    list-style: none;
    cursor: pointer;
    font-size: clamp(1.125rem, 1.4vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 200ms var(--ease-out);
  }

  .question summary::-webkit-details-marker {
    display: none;
  }

  .question summary:hover {
    color: var(--green);
  }

  .question-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    transition: transform 300ms var(--ease-out);
  }

  .question-toggle :global(svg) {
    width: 16px;
  }

  .question[open] .question-toggle {
    transform: rotate(45deg);
  }

  .question p {
    max-width: 62ch;
    padding-bottom: clamp(20px, 1.8vw, 28px);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--smoke);
  }

  @media (max-width: 1000px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
